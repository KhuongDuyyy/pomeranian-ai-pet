{
  "name": "pomeranian-ai-pet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "dev": "tsc && node dist/src/index.js",
    "interactive": "tsc && node dist/src/index.js --interactive",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "build:ui": "tsc && tsc -p web/tsconfig.json && vite build",
    "ui": "npm run build:ui && node dist/src/server.js",
    "test": "tsc && node --test --test-isolation=none dist/tests/*.test.js"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.0"
  }
}
